diff --git a/src/components/native/outfit.ts b/src/components/native/outfit.ts
new file mode 100644
index 0000000000000000000000000000000000000000..69ce36d09d62f5adbec08fa86b9435da4f3b458d
--- /dev/null
+++ b/src/components/native/outfit.ts
@@ -0,0 +1,65 @@
+import { createContext, useSyncExternalStore } from 'react'
+import type { StyleProp, TextStyle } from 'react-native'
+import { StyleSheet } from 'react-native'
+
+// HAWConnect: React Native needs one fontFamily per weight for bundled fonts, so Text
+// and TextInput default to Outfit-Regular and map fontWeight (from className or style)
+// to the matching Outfit face. Styles with their own non-Outfit fontFamily are untouched.
+const outfitFace = (weight: TextStyle['fontWeight']) => {
+    const value = weight === undefined || weight === 'normal' ? 400 : weight === 'bold' ? 700 : Number(weight)
+    if (value >= 700) return 'Outfit-Bold'
+    if (value >= 600) return 'Outfit-SemiBold'
+    if (value >= 500) return 'Outfit-Medium'
+
+    return 'Outfit-Regular'
+}
+
+// HAWConnect "Interface font" setting, shared with the app through a global symbol
+// (src/utils/interface-font.ts): 'default' uses Outfit, 'system' the platform font.
+type InterfaceFontStore = { mode: 'default' | 'system'; listeners: Set<() => void> }
+const STORE_KEY = Symbol.for('hawconnect.interfaceFont')
+const globalStore = globalThis as unknown as Record<symbol, InterfaceFontStore | undefined>
+const fontStore = (): InterfaceFontStore => {
+    globalStore[STORE_KEY] ??= { mode: 'default', listeners: new Set() }
+
+    return globalStore[STORE_KEY]
+}
+const subscribe = (listener: () => void) => {
+    fontStore().listeners.add(listener)
+
+    return () => {
+        fontStore().listeners.delete(listener)
+    }
+}
+
+/** True while the app's Interface font setting is 'system'. */
+export const useSystemFont = () => useSyncExternalStore(subscribe, () => fontStore().mode === 'system')
+
+// True inside a patched Text: a nested Text without its own weight or family inherits the parent's face.
+export const NestedTextContext = createContext(false)
+
+export const withOutfit = (style: StyleProp<TextStyle>, nested = false, system = false): StyleProp<TextStyle> => {
+    const flat = StyleSheet.flatten(style) ?? {}
+
+    if (system) {
+        if (flat.fontFamily?.startsWith('Outfit')) {
+            const { fontFamily: _outfit, ...rest } = flat
+
+            return rest
+        }
+
+        return style
+    }
+
+    if (nested && flat.fontFamily === undefined && flat.fontWeight === undefined) {
+        return style
+    }
+
+    if (flat.fontFamily !== undefined && !flat.fontFamily.startsWith('Outfit')) {
+        return style
+    }
+
+    const { fontWeight, ...rest } = flat
+
+    return { ...rest, fontFamily: outfitFace(fontWeight) }
+}
